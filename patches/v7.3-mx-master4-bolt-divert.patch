HID: logitech-hidpp: divert hi-res wheel events on Bolt receivers

hid-logitech-dj deliberately treats every Bolt receiver USB interface
except the DJ one as a plain generic HID device (logi_dj_probe()).
Standard mouse input from paired devices arrives on those generic
interfaces, is emitted by the receiver's own input node, and is never
forwarded to the per-device HID++ child.

hid-logitech-hidpp, bound to that child, still probes feature 0x2121
over the DJ interface and enables high-resolution mode with wheel
events targeted at the standard HID path (use_hidpp=false), expecting
to rescale the multiplied deltas in its event handler. On a Bolt
topology those deltas bypass the driver entirely and reach userspace
unscaled: one physical wheel notch on an MX Master 4 (WPID B042,
multiplier 15) produces 15 REL_WHEEL clicks.

Detect the Bolt topology and instead divert wheel events to HID++
notifications, which hid-logitech-dj does forward to the child. Handle
the x2121 wheelMovement event (0x00) by feeding the signed 16-bit
delta through hidpp_scroll_counter_handle_scroll(), preserving both
high-resolution REL_WHEEL_HI_RES output and the low-resolution
REL_WHEEL emulation. The wheel mode is re-applied on every connect
event, so a wake or power cycle cannot leave the wheel in another mode.

The wheel mode is state in the device, and nothing that binds after this
driver consumes the diverted notifications: hid-generic on a kernel whose
hid-logitech-dj does not bind Bolt receivers, or this driver without the
Bolt handling.  So on remove (module unload or unbind) the wheel is put
back on native, low-resolution reporting, the device default, while the
device is still reachable.

The thumbwheel (feature 0x2150) is explicitly kept on native HID
reporting on every connect: diverting it on the MX Master 4 silences
its standard AC Pan reports without producing any notification on the
thumbwheel feature index, and the native path is not affected by the
0x2121 multiplier. This also heals diversion left enabled by
userspace tools.

Verified on an MX Master 4 "for Mac" via Bolt receiver 046d:c548:
ratchet notches produce exactly one click (delta 15 -> v120 120), slow
and free-spin rotation produces sub-notch deltas (1..7, batched under
load), signs correct in both directions, thumbwheel unaffected.  The restore
on remove is build-tested only.

diff --git a/drivers/hid/hid-logitech-hidpp.c b/drivers/hid/hid-logitech-hidpp.c
index 493763a..0c22405 100644
--- a/drivers/hid/hid-logitech-hidpp.c
+++ b/drivers/hid/hid-logitech-hidpp.c
@@ -212,6 +212,8 @@ struct hidpp_device {
 	const struct hidpp_reprog_control_mapping *reprog_controls;
 
 	int hires_wheel_multiplier;
+	bool hires_wheel_diverted;
+	u8 thumbwheel_feature_index;
 	u8 hires_wheel_feature_index;
 
 	bool connected_once;
@@ -2045,6 +2047,7 @@ static int hidpp_hrs_set_highres_scrolling_mode(struct hidpp_device *hidpp,
 
 #define CMD_HIRES_WHEEL_GET_WHEEL_CAPABILITY	0x00
 #define CMD_HIRES_WHEEL_SET_WHEEL_MODE		0x20
+#define EVENT_HIRES_WHEEL_MOVEMENT		0x00
 
 static int hidpp_hrw_get_wheel_capability(struct hidpp_device *hidpp,
 	u8 *multiplier)
@@ -2094,6 +2097,45 @@ static int hidpp_hrw_set_wheel_mode(struct hidpp_device *hidpp, bool invert,
 					   params, sizeof(params), &response);
 }
 
+/* -------------------------------------------------------------------------- */
+/* 0x2150: Thumbwheel                                                         */
+/* -------------------------------------------------------------------------- */
+
+#define HIDPP_PAGE_THUMBWHEEL			0x2150
+
+#define CMD_THUMBWHEEL_SET_REPORTING		0x20
+
+/*
+ * Ensure thumbwheel events use native HID reporting.  On the MX Master 4
+ * over a Bolt receiver, diverting the thumbwheel silences its standard
+ * AC Pan reports without producing usable x2150 notifications (observed:
+ * nothing arrives on the thumbwheel feature index), so the native path -
+ * which works at native resolution - is explicitly restored on every
+ * connect in case userspace (e.g. Solaar) left diversion enabled.
+ */
+static int hidpp20_thumbwheel_set_native(struct hidpp_device *hidpp)
+{
+	struct hidpp_report response;
+	u8 params[2] = { 0, 0 };	/* native reporting, no inversion */
+	int ret;
+
+	if (hidpp->thumbwheel_feature_index == 0) {
+		ret = hidpp_root_get_feature(hidpp, HIDPP_PAGE_THUMBWHEEL,
+					     &hidpp->thumbwheel_feature_index);
+		if (ret) {
+			hidpp->thumbwheel_feature_index = 0xff;
+			return ret;
+		}
+	}
+	if (hidpp->thumbwheel_feature_index == 0xff)
+		return -ENODEV;
+
+	return hidpp_send_fap_command_sync(hidpp,
+					   hidpp->thumbwheel_feature_index,
+					   CMD_THUMBWHEEL_SET_REPORTING,
+					   params, sizeof(params), &response);
+}
+
 /* -------------------------------------------------------------------------- */
 /* 0x4301: Solar Keyboard                                                     */
 /* -------------------------------------------------------------------------- */
@@ -3904,18 +3946,57 @@ static int hidpp10_consumer_keys_raw_event(struct hidpp_device *hidpp,
 /* High-resolution scroll wheels                                              */
 /* -------------------------------------------------------------------------- */
 
+/*
+ * Devices paired to a Bolt receiver deliver their standard input reports
+ * through the receiver's keyboard/mouse USB interfaces, which
+ * hid-logitech-dj deliberately handles as plain generic HID devices
+ * (see logi_dj_probe()).  Wheel events therefore never reach this driver,
+ * so the multiplied hi-res deltas would be emitted to userspace unscaled
+ * (e.g. 15 REL_WHEEL clicks per physical notch on an MX Master 4).
+ * Detect that topology so hi-res wheel events are diverted to HID++
+ * notifications behind a Bolt receiver, and hi-res scrolling without a
+ * HID++ route (0x2120) stays off.
+ */
+static bool hidpp_is_bolt_receiver_child(struct hidpp_device *hidpp)
+{
+	struct hid_device *hdev = hidpp->hid_dev;
+
+	return hdev->group == HID_GROUP_LOGITECH_DJ_DEVICE &&
+	       hdev->dev.parent &&
+	       to_hid_device(hdev->dev.parent)->product ==
+			USB_DEVICE_ID_LOGITECH_BOLT_RECEIVER;
+}
+
 static int hi_res_scroll_enable(struct hidpp_device *hidpp)
 {
 	int ret;
 	u8 multiplier = 1;
+	bool bolt = hidpp_is_bolt_receiver_child(hidpp);
 
 	if (hidpp->capabilities & HIDPP_CAPABILITY_HIDPP20_HI_RES_WHEEL) {
-		ret = hidpp_hrw_set_wheel_mode(hidpp, false, true, false);
+		/*
+		 * Behind a Bolt receiver the standard input path bypasses this
+		 * driver, so hi-res deltas would reach userspace unscaled.
+		 * Divert wheel events to HID++ notifications instead: those
+		 * ARE forwarded to this driver by hid-logitech-dj and handled
+		 * in hidpp20_hires_wheel_raw_event().
+		 */
+		hidpp->hires_wheel_diverted = bolt;
+		ret = hidpp_hrw_set_wheel_mode(hidpp, false, true, bolt);
 		if (ret == 0)
 			ret = hidpp_hrw_get_wheel_capability(hidpp, &multiplier);
+		if (ret == 0 && bolt)
+			hid_dbg(hidpp->hid_dev,
+				"Bolt receiver: hi-res wheel diverted to HID++ (multiplier %d)\n",
+				multiplier);
 	} else if (hidpp->capabilities & HIDPP_CAPABILITY_HIDPP20_HI_RES_SCROLL) {
-		ret = hidpp_hrs_set_highres_scrolling_mode(hidpp, true,
+		ret = hidpp_hrs_set_highres_scrolling_mode(hidpp, !bolt,
 							   &multiplier);
+		if (ret == 0 && bolt) {
+			hidpp->hires_wheel_multiplier = 1;
+			hidpp->vertical_wheel_counter.wheel_multiplier = 1;
+			return 0;
+		}
 	} else /* if (hidpp->capabilities & HIDPP_CAPABILITY_HIDPP10_FAST_SCROLL) */ {
 		ret = hidpp10_enable_scrolling_acceleration(hidpp);
 		multiplier = 8;
@@ -3938,6 +4019,33 @@ static int hi_res_scroll_enable(struct hidpp_device *hidpp)
 	return 0;
 }
 
+/*
+ * Put a diverted wheel back on native HID reporting when the driver lets go
+ * of the device (module unload or unbind).  The wheel mode is state in the
+ * device, and whatever binds next - this driver without the Bolt topology
+ * handling, or hid-generic on a kernel whose hid-logitech-dj does not bind
+ * Bolt receivers - ignores HID++ wheel notifications, so a wheel left
+ * diverted would stop scrolling.  Low resolution is the device default and
+ * what hid-generic expects.  A device that is asleep answers with an error
+ * and keeps its mode.
+ */
+static void hi_res_scroll_restore_native(struct hidpp_device *hidpp)
+{
+	int ret;
+
+	if (!hidpp->hires_wheel_diverted)
+		return;
+
+	hidpp->hires_wheel_diverted = false;
+	/* hid_device_remove() stopped input; the answer needs it */
+	hid_device_io_start(hidpp->hid_dev);
+	ret = hidpp_hrw_set_wheel_mode(hidpp, false, false, false);
+	if (ret)
+		hid_dbg(hidpp->hid_dev,
+			"Bolt receiver: could not restore native wheel reporting: %d\n",
+			ret);
+}
+
 static int hidpp_initialize_hires_scroll(struct hidpp_device *hidpp)
 {
 	int ret;
@@ -3989,6 +4097,37 @@ static int hidpp20_hires_wheel_raw_event(struct hidpp_device *hidpp,
 	    data[2] != hidpp->hires_wheel_feature_index)
 		return 0;
 
+	/*
+	 * Event 0x00: wheelMovement, sent when wheel events are diverted to
+	 * HID++ (Bolt receivers, where the standard input path bypasses this
+	 * driver).  Events carry sw_id 0 in the low nibble; command responses
+	 * are consumed by the answer matching before we get here.
+	 * params: data[4] bits 0-3 = sampling periods, bit 4 = resolution;
+	 * data[5..6] = signed 16-bit big-endian vertical delta, in hi-res
+	 * (1/multiplier notch) units when the resolution bit is set.
+	 */
+	if (hidpp->hires_wheel_diverted && data[3] == EVENT_HIRES_WHEEL_MOVEMENT) {
+		s16 delta;
+
+		if (size < 7 || !hidpp->input ||
+		    hidpp->vertical_wheel_counter.wheel_multiplier == 0)
+			return 1;
+
+		delta = (s16)((data[5] << 8) | data[6]);
+		if (delta == 0)
+			return 1;
+
+		if (!(data[4] & 0x10))
+			/* low-res delta: convert to hi-res units */
+			delta *= hidpp->hires_wheel_multiplier;
+
+		hidpp_scroll_counter_handle_scroll(hidpp->input,
+						   &hidpp->vertical_wheel_counter,
+						   delta);
+		input_sync(hidpp->input);
+		return 1;
+	}
+
 	if ((data[3] & 0xf0) == CMD_HIRES_WHEEL_SET_WHEEL_MODE) {
 		u8 mode = data[4];
 		bool hires = (mode & 0x02) != 0;
@@ -4605,6 +4744,13 @@ static void hidpp_connect_event(struct work_struct *work)
 	if (hidpp->capabilities & HIDPP_CAPABILITY_HI_RES_SCROLL)
 		hi_res_scroll_enable(hidpp);
 
+	/*
+	 * Keep the thumbwheel on native HID reporting (see
+	 * hidpp20_thumbwheel_set_native()).  Re-applied on every connect.
+	 */
+	if (hidpp->protocol_major >= 2 && hidpp_is_bolt_receiver_child(hidpp))
+		hidpp20_thumbwheel_set_native(hidpp);
+
 	if (!(hidpp->quirks & HIDPP_QUIRK_DELAYED_INIT) || hidpp->delayed_input)
 		/* if the input nodes are already created, we can stop now */
 		return;
@@ -4847,6 +4993,11 @@ static void hidpp_remove(struct hid_device *hdev)
 
 	sysfs_remove_group(&hdev->dev.kobj, &ps_attribute_group);
 
+	/* no connect or reset work may divert the wheel again after this */
+	cancel_work_sync(&hidpp->work);
+	cancel_work_sync(&hidpp->reset_hi_res_work);
+	hi_res_scroll_restore_native(hidpp);
+
 	hid_hw_stop(hdev);
 	cancel_work_sync(&hidpp->work);
 	cancel_work_sync(&hidpp->reset_hi_res_work);
